{
  "name": "pkg_mauticforjoomla",
  "description": "Joomla System Plugin for Mautic",
  "version": "3.0.0",
  "copyright": "Copyright (C) 2014 - 2025 Mautic All Rights Reserved.",
  "config": {
    "build": {
      "extension": "build/tmp",
      "bannercopyright": "Copyright (C) 2014 - 2025 Mautic All Rights Reserved."
    },
    "dev": {
      "extension": [
        {
          "name": "plg_system_mautic",
          "version": "3.0.0",
          "media": "media"
        },
        {
          "name": "lib_mautic",
          "version": "3.1.0"
        }
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0"
  },
  "scripts": {
    "eslint:check": "eslint --no-error-on-unmatched-pattern --config .eslintrc.mjs ./plg_system_mautic/",
    "eslint:fix": "eslint --no-error-on-unmatched-pattern --fix --config .eslintrc.mjs ./plg_system_mautic",
    "prebuild:prod": "npm i && cd lib_mautic/src && composer i && npm run clean:build",
    "build:prod": "node build/SetupPackage.mjs && cd build/tmp && npm pack",
    "clean:build": "rm -r ./${npm_package_config_build_extension}"
  }
}
